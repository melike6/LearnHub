@model IEnumerable<LearnHub.Models.Course>
@{
    ViewData["Title"] = "Kurslar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kurs Yönetimi</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Kurs Adı</th>
            <th>Kategori</th>
            <th>Eğitmen</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Category.Name</td>
                <td>@course.Instructor.FullName</td>
                <td>
                    @if (course.Status == LearnHub.Models.CourseStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Bekliyor</span>
                    }
                    else if (course.Status == LearnHub.Models.CourseStatus.Approved)
                    {
                        <span class="badge bg-success">Onaylı</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Reddedildi</span>
                    }
                </td>
                <td>
                    @if (course.Status == LearnHub.Models.CourseStatus.Pending)
                    {
                        <form asp-action="ApproveCourse" asp-route-id="@course.Id"
                              method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                        </form>
                        <form asp-action="RejectCourse" asp-route-id="@course.Id"
                              method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>