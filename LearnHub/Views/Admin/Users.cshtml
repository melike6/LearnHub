@model IEnumerable<LearnHub.Models.ApplicationUser>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<h2>Kullanıcı Yönetimi</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Roller</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var roles = userRoles!.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@string.Join(", ", roles)</td>
                <td>
                    @if (!roles.Contains("Admin"))
                    {
                        @if (!roles.Contains("Instructor"))
                        {
                            <form asp-action="MakeInstructor" asp-route-userId="@user.Id"
                                  method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success">
                                    Eğitmen Yap
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="MakeStudent" asp-route-userId="@user.Id"
                                  method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-warning">
                                    Öğrenci Yap
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>