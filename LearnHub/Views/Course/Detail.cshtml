@model LearnHub.Models.Course
@{
    ViewData["Title"] = Model.Title;
    bool isEnrolled = ViewBag.IsEnrolled ?? false;
    int progressPercent = ViewBag.ProgressPercent ?? 0;
}

<div class="row">
    <div class="col-md-8">
        @if (Model.CoverImage != null)
        {
            <img src="@Model.CoverImage" class="img-fluid rounded mb-3"
                 style="max-height:300px;width:100%;object-fit:cover" />
        }
        <h2>@Model.Title</h2>
        <p class="text-muted">
            <strong>Kategori:</strong> @Model.Category.Name |
            <strong>Eğitmen:</strong> @Model.Instructor.FullName
        </p>
        <p>@Model.Description</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (User.Identity!.IsAuthenticated)
        {
            @if (!isEnrolled)
            {
                <form asp-action="Enroll" asp-route-courseId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-lg">
                        Kursa Kayıt Ol
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-success">Bu kursa kayıtlısınız.</div>
                <div class="mb-3">
                    <strong>İlerleme: %@progressPercent</strong>
                    <div class="progress mt-1">
                        <div class="progress-bar" role="progressbar"
                             style="width:@progressPercent%"
                             aria-valuenow="@progressPercent"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login"
               class="btn btn-outline-primary">
                Kayıt olmak için giriş yapın
            </a>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <strong>Ders Listesi</strong>
            </div>
            <ul class="list-group list-group-flush">
                @if (!Model.Lessons.Any())
                {
                    <li class="list-group-item text-muted">Henüz ders eklenmemiş.</li>
                }
                @foreach (var lesson in Model.Lessons)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@lesson.Order. @lesson.Title</span>
                        @if (isEnrolled)
                        {
                            <a asp-controller="Course" asp-action="Lesson"
                               asp-route-id="@lesson.Id"
                               class="btn btn-sm btn-outline-primary">Git</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>