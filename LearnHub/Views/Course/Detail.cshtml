@model LearnHub.Models.Course
@{
    ViewData["Title"] = Model.Title;
    bool isEnrolled = ViewBag.IsEnrolled ?? false;
    int progressPercent = ViewBag.ProgressPercent ?? 0;
    var reviews = ViewBag.Reviews as List<LearnHub.Models.Review> ?? new();
    double averageRating = ViewBag.AverageRating ?? 0.0;
    var userReview = ViewBag.UserReview as LearnHub.Models.Review;
}

<div class="row">
    <div class="col-md-8">
        @if (Model.CoverImage != null)
        {
            <img src="@Model.CoverImage" class="img-fluid rounded mb-3"
                 style="max-height:300px;width:100%;object-fit:cover" />
        }

        <h2>@Model.Title</h2>
        <p class="text-muted">
            <strong>Kategori:</strong> @Model.Category.Name |
            <strong>Eğitmen:</strong> @Model.Instructor.FullName
        </p>

        @* Ortalama puan *@
        @if (reviews.Any())
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                @for (int i = 1; i <= 5; i++)
                {
                    <span style="font-size:1.3rem;color:@(i <= averageRating ? "#f5a623" : "#ccc")">
                        ★
                    </span>
                }
                <span class="fw-bold">@averageRating</span>
                <span class="text-muted small">(@reviews.Count yorum)</span>
            </div>
        }

        <p>@Model.Description</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (User.Identity!.IsAuthenticated)
        {
            @if (!isEnrolled)
            {
                <form asp-action="Enroll" asp-route-courseId="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-lg">
                        Kursa Kayıt Ol
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-success">Bu kursa kayıtlısınız.</div>
                <div class="mb-3">
                    <strong>İlerleme: %@progressPercent</strong>
                    <div class="progress mt-1">
                        <div class="progress-bar" role="progressbar"
                             style="width:@progressPercent%"
                             aria-valuenow="@progressPercent"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>

                @* Sertifika butonu *@
                <div class="mt-2 mb-3">
                    <a asp-controller="Certificate" asp-action="Index"
                       asp-route-courseId="@Model.Id"
                       class="btn btn-warning">
                        🎓 Sertifikamı Al
                    </a>
                </div>

                @if (Model.Quizzes.Any())
                {
                    <h5 class="mt-3">Quizler</h5>
                    @foreach (var quiz in Model.Quizzes.Where(q => q.IsActive))
                    {
                        <a asp-controller="Quiz" asp-action="Take"
                           asp-route-id="@quiz.Id"
                           class="btn btn-outline-primary me-2 mb-2">
                            📝 @quiz.Title
                        </a>
                    }
                }
            }
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login"
               class="btn btn-outline-primary">
                Kayıt olmak için giriş yapın
            </a>
        }

        <hr class="my-4" />

        @* Yorum bölümü *@
        <h4>
            Yorumlar
            <small class="text-muted fs-6">(@reviews.Count)</small>
        </h4>

        @* Yorum formu — sadece kayıtlı öğrenciye göster *@
        @if (isEnrolled)
        {
            <div class="card mb-4">
                <div class="card-header">
                    @(userReview != null ? "Yorumunu Güncelle" : "Yorum Yaz")
                </div>
                <div class="card-body">
                    <form asp-action="AddReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="form-group mb-3">
                            <label>Puan</label>
                            <div class="d-flex gap-2 mt-1" id="starContainer">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star-btn"
                                          data-value="@i"
                                          style="font-size:1.8rem;cursor:pointer;color:@(userReview != null && userReview.Rating >= i ? "#f5a623" : "#ccc")">
                                        ★
                                    </span>
                                }
                            </div>
                            <input type="hidden" name="rating" id="ratingInput"
                                   value="@(userReview?.Rating ?? 0)" required />
                        </div>

                        <div class="form-group mb-3">
                            <label>Yorum</label>
                            <textarea name="comment" class="form-control"
                                  rows="3" required
                                  maxlength="1000">@userReview?.Comment</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            @(userReview != null ? "Güncelle" : "Gönder")
                        </button>

                        @if (userReview != null)
                        {
                            <form asp-action="DeleteReview" method="post"
                                  style="display:inline" class="ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId"
                                       value="@Model.Id" />
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Yorumu silmek istiyor musunuz?')">
                                    Yorumu Sil
                                </button>
                            </form>
                        }
                    </form>
                </div>
            </div>
        }

        @* Yorum listesi *@
        @if (!reviews.Any())
        {
            <p class="text-muted">Henüz yorum yapılmamış.</p>
        }
        else
        {
            @foreach (var review in reviews)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@review.User.FullName</strong>
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span style="color:@(i <= review.Rating ? "#f5a623" : "#ccc")">★</span>
                                    }
                                </div>
                            </div>
                            <small class="text-muted">
                                @review.CreatedAt.ToString("dd.MM.yyyy")
                            </small>
                        </div>
                        <p class="mt-2 mb-0">@review.Comment</p>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><strong>Ders Listesi</strong></div>
            <ul class="list-group list-group-flush">
                @if (!Model.Lessons.Any())
                {
                    <li class="list-group-item text-muted">
                        Henüz ders eklenmemiş.
                    </li>
                }
                @foreach (var lesson in Model.Lessons)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@lesson.Order. @lesson.Title</span>
                        @if (isEnrolled)
                        {
                            <a asp-controller="Course" asp-action="Lesson"
                               asp-route-id="@lesson.Id"
                               class="btn btn-sm btn-outline-primary">Git</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const stars = document.querySelectorAll('.star-btn');
        const ratingInput = document.getElementById('ratingInput');

        stars.forEach(star => {
            star.addEventListener('click', () => {
                const val = parseInt(star.dataset.value);
                ratingInput.value = val;
                stars.forEach(s => {
                    s.style.color = parseInt(s.dataset.value) <= val
                        ? '#f5a623' : '#ccc';
                });
            });

            star.addEventListener('mouseover', () => {
                const val = parseInt(star.dataset.value);
                stars.forEach(s => {
                    s.style.color = parseInt(s.dataset.value) <= val
                        ? '#f5a623' : '#ccc';
                });
            });

            star.addEventListener('mouseout', () => {
                const current = parseInt(ratingInput.value);
                stars.forEach(s => {
                    s.style.color = parseInt(s.dataset.value) <= current
                        ? '#f5a623' : '#ccc';
                });
            });
        });
    </script>
}