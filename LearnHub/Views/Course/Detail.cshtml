@model LearnHub.Models.Course
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-8">
        @if (Model.CoverImage != null)
        {
            <img src="@Model.CoverImage" class="img-fluid rounded mb-3"
                 style="max-height:300px;width:100%;object-fit:cover" />
        }
        <h2>@Model.Title</h2>
        <p class="text-muted">
            <strong>Kategori:</strong> @Model.Category.Name |
            <strong>Eğitmen:</strong> @Model.Instructor.FullName
        </p>
        <p>@Model.Description</p>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <strong>Ders Listesi</strong>
            </div>
            <ul class="list-group list-group-flush">
                @if (!Model.Lessons.Any())
                {
                    <li class="list-group-item text-muted">Henüz ders eklenmemiş.</li>
                }
                @foreach (var lesson in Model.Lessons)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@lesson.Order. @lesson.Title</span>
                        <a asp-controller="Course" asp-action="Lesson"
                           asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary">
                            Git
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>