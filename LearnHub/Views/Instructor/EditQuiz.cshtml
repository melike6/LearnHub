@model LearnHub.Models.Quiz
@{
    ViewData["Title"] = "Quiz Düzenle";
}

<h2>@Model.Title — Soru Yönetimi</h2>
<p class="text-muted">
    <a asp-action="Quizzes" asp-route-courseId="@Model.CourseId">← Quizlere Dön</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-7">
        <h5>Mevcut Sorular</h5>

        @if (!Model.Questions.Any())
        {
            <div class="alert alert-info">Henüz soru eklenmemiş.</div>
        }

        @foreach (var question in Model.Questions.OrderBy(q => q.Order))
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between">
                    <strong>@question.Order. @question.Text</strong>
                    <form asp-action="DeleteQuestion" asp-route-id="@question.Id"
                          method="post" style="display:inline"
                          onsubmit="return confirm('Soruyu silmek istiyor musunuz?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var option in question.Options)
                    {
                        <li class="list-group-item @(option.IsCorrect ? "list-group-item-success" : "")">
                            @option.Text
                            @if (option.IsCorrect)
                            {
                                <span class="badge bg-success ms-2">Doğru</span>
                            }
                        </li>
                    }
                </ul>
                <div class="card-footer">
                    <form asp-action="AddOption" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="questionId" value="@question.Id" />
                        <input type="text" name="text" class="form-control form-control-sm"
                               placeholder="Seçenek metni" required />
                        <div class="form-check mt-1">
                            <input type="checkbox" name="isCorrect" value="true"
                                   class="form-check-input" id="correct_@question.Id" />
                            <label class="form-check-label" for="correct_@question.Id">
                                Doğru
                            </label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Ekle</button>
                    </form>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-header"><strong>Yeni Soru Ekle</strong></div>
            <div class="card-body">
                <form asp-action="AddQuestion" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quizId" value="@Model.Id" />
                    <input type="text" name="text" class="form-control"
                           placeholder="Soru metni" required />
                    <button type="submit" class="btn btn-success">Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>