@model IEnumerable<LearnHub.Models.Course>
@{
    ViewData["Title"] = "Eğitmen Paneli";
}

<h2 class="mb-4">Eğitmen Paneli</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center p-3 border-success">
            <div class="fs-2 fw-bold text-success">@ViewBag.ApprovedCourses</div>
            <div class="text-muted">Aktif Kurs</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-warning">
            <div class="fs-2 fw-bold text-warning">@ViewBag.PendingCourses</div>
            <div class="text-muted">Onay Bekleyen</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-primary">
            <div class="fs-2 fw-bold text-primary">@ViewBag.TotalStudents</div>
            <div class="text-muted">Toplam Öğrenci</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-info">
            <div class="fs-2 fw-bold text-info">@ViewBag.TotalLessons</div>
            <div class="text-muted">Toplam Ders</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Kurslarım</h4>
    <a asp-action="CreateCourse" class="btn btn-success">+ Yeni Kurs</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz kurs oluşturmadınız.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Kurs Adı</th>
                <th>Kategori</th>
                <th>Ders</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>@course.Category.Name</td>
                    <td>@course.Lessons.Count</td>
                    <td>
                        @if (course.Status == LearnHub.Models.CourseStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                        }
                        else if (course.Status == LearnHub.Models.CourseStatus.Approved)
                        {
                            <span class="badge bg-success">Onaylı</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Reddedildi</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditCourse" asp-route-id="@course.Id"
                           class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Lessons" asp-route-courseId="@course.Id"
                           class="btn btn-sm btn-primary">Dersler</a>
                        <a asp-action="Quizzes" asp-route-courseId="@course.Id"
                           class="btn btn-sm btn-info">Quizler</a>
                        <a asp-action="StudentProgress" asp-route-courseId="@course.Id"
                           class="btn btn-sm btn-secondary">İlerleme</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}