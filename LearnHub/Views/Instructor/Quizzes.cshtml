@model IEnumerable<LearnHub.Models.Quiz>
@{
    ViewData["Title"] = "Quizler";
    var course = ViewBag.Course as LearnHub.Models.Course;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@course?.Title — Quizler</h2>
    <div>
        <a asp-action="CreateQuiz" asp-route-courseId="@course?.Id"
           class="btn btn-success">+ Yeni Quiz</a>
        <a asp-action="Index" class="btn btn-secondary">Panele Dön</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Bu kursa henüz quiz eklenmemiş.</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Quiz Adı</th>
                <th>Soru Sayısı</th>
                <th>Geçme Puanı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var quiz in Model)
            {
                <tr>
                    <td>@quiz.Title</td>
                    <td>@quiz.Questions.Count</td>
                    <td>%@quiz.PassingScore</td>
                    <td>
                        <a asp-action="EditQuiz" asp-route-id="@quiz.Id"
                           class="btn btn-sm btn-warning">Düzenle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}