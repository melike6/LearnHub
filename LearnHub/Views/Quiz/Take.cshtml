@model LearnHub.Models.Quiz
@{
    ViewData["Title"] = Model.Title;
}

<h2>@Model.Title</h2>
<p class="text-muted">
    <a asp-controller="Course" asp-action="Detail"
       asp-route-id="@Model.CourseId">← @Model.Course.Title</a>
</p>

@if (Model.Description != null)
{
    <p>@Model.Description</p>
}

<div class="alert alert-info">
    Geçme puanı: %@Model.PassingScore
</div>

<form asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="quizId" value="@Model.Id" />

    @foreach (var question in Model.Questions.OrderBy(q => q.Order))
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@question.Order. @question.Text</strong>
            </div>
            <div class="card-body">
                @foreach (var option in question.Options)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio"
                               name="answers[@question.Id]"
                               value="@option.Id"
                               id="opt_@option.Id"
                               required />
                        <label class="form-check-label" for="opt_@option.Id">
                            @option.Text
                        </label>
                    </div>
                }
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-lg">
        Quizi Tamamla ve Gönder
    </button>
</form>