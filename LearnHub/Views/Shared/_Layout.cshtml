<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LearnHub.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
        }

        .card {
            transition: transform .2s;
        }

            .card:hover {
                transform: translateY(-3px);
            }

        footer {
            margin-top: 60px;
            padding: 20px 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand text-white"
                   asp-controller="Home" asp-action="Index">
                    📚 LearnHub
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Index">
                                Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Course" asp-action="Index">
                                Kurslar
                            </a>
                        </li>
                    </ul>

                    <form class="d-flex me-3"
                          asp-controller="Home" asp-action="Search"
                          method="get">
                        <input class="form-control form-control-sm me-2"
                               type="search" name="q"
                               placeholder="Kurs ara..." style="width:200px" />
                        <button class="btn btn-outline-light btn-sm"
                                type="submit">
                            Ara
                        </button>
                    </form>

                    <ul class="navbar-nav">
                        @using Microsoft.AspNetCore.Identity
                        @inject SignInManager<LearnHub.Models.ApplicationUser> SignInManager
                        @inject UserManager<LearnHub.Models.ApplicationUser> UserManager

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin" asp-action="Index">
                                        Admin Panel
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Instructor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Instructor" asp-action="Index">
                                        Eğitmen Paneli
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Student" asp-action="Index">
                                    Panelim
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   data-bs-toggle="dropdown">
                                    👤 @UserManager.GetUserName(User)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profile"
                                           asp-action="Index">
                                            Profilim
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              asp-route-returnUrl="/"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="dropdown-item">
                                                Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    Kayıt Ol
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-light btn-sm ms-1 px-3"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Giriş Yap
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white">
        <div class="container text-center text-muted">
            <small>&copy; @DateTime.Now.Year LearnHub — Tüm hakları saklıdır.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>