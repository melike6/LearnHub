@model IEnumerable<LearnHub.Models.Enrollment>
@{
    ViewData["Title"] = "Panelim";
    var completedIds = ViewBag.CompletedLessonIds as HashSet<int> ?? new HashSet<int>();
    var quizAttempts = ViewBag.QuizAttempts as
        List<LearnHub.Models.QuizAttempt> ?? new();
}

<h2>Panelim</h2>
<div class="mb-3">
    <a asp-controller="Certificate" asp-action="MyCertificates"
       class="btn btn-outline-warning">
        🎓 Sertifikalarım
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz hiçbir kursa kayıt olmadınız.
        <a asp-controller="Course" asp-action="Index">Kurslara göz at</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        @foreach (var enrollment in Model)
        {
            var totalLessons = enrollment.Course.Lessons.Count;
            var completedCount = enrollment.Course.Lessons
            .Count(l => completedIds.Contains(l.Id));
            var percent = totalLessons > 0
            ? (int)((double)completedCount / totalLessons * 100) : 0;

            <div class="col">
                <div class="card h-100">
                    @if (enrollment.Course.CoverImage != null)
                    {
                        <img src="@enrollment.Course.CoverImage"
                             class="card-img-top"
                             style="height:150px;object-fit:cover" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@enrollment.Course.Title</h5>
                        <p class="card-text text-muted small">
                            @enrollment.Course.Category.Name
                        </p>
                        <p class="card-text small">
                            Kayıt: @enrollment.EnrolledAt.ToString("dd.MM.yyyy")
                        </p>
                        <div class="mb-2">
                            <small>
                                İlerleme: %@percent
                                (@completedCount / @totalLessons ders)
                            </small>
                            <div class="progress mt-1" style="height:8px">
                                <div class="progress-bar bg-success"
                                     style="width:@percent%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Course" asp-action="Detail"
                           asp-route-id="@enrollment.CourseId"
                           class="btn btn-primary btn-sm">Kursa Git</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (quizAttempts.Any())
    {
        <h4>Quiz Geçmişim</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Kurs</th>
                    <th>Puan</th>
                    <th>Sonuç</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attempt in quizAttempts)
                {
                    <tr>
                        <td>@attempt.Quiz.Title</td>
                        <td>@attempt.Quiz.Course.Title</td>
                        <td>%@attempt.Score</td>
                        <td>
                            @if (attempt.IsPassed)
                            {
                                <span class="badge bg-success">Geçti</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Kaldı</span>
                            }
                        </td>
                        <td>@attempt.AttemptedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}